{
  "project": {
    "key": "HER",
    "name": "Hermes Delivery"
  },
  "board": {
    "name": "Hermes Delivery Board",
    "columns": [
      "Backlog",
      "Ready",
      "In Progress",
      "Review",
      "Done"
    ]
  },
  "roots": [
    "~/Development"
  ],
  "profiles": {
    "default": {
      "displayName": "Primary Developer",
      "jiraAccountId": "replace-with-jira-account-id-from-atlassian-mcp",
      "responsibilities": [
        "implementation",
        "tests",
        "deployment-hand-off"
      ],
      "deployment": {
        "strategy": "manual-approval",
        "environments": [
          "local",
          "staging"
        ],
        "notes": "Profile owner reviews deployment steps after PR approval."
      },
      "providers": {
        "githubOwner": "replace-with-github-owner",
        "bitbucketWorkspace": "replace-with-bitbucket-workspace"
      }
    }
  },
  "automation": {
    "mode": "manual",
    "steps": {
      "createHermesItem": "auto",
      "assignProfile": "manual",
      "createBranch": "manual",
      "commit": "manual",
      "pullRequest": "reviewed-only"
    }
  },
  "branchTypes": {
    "hotfix": {
      "issue_types": [
        "Incident",
        "Hotfix"
      ],
      "labels": [
        "hotfix",
        "urgent",
        "p0",
        "p1"
      ],
      "priorities": [
        "Highest",
        "Critical",
        "Blocker"
      ]
    },
    "bugfix": {
      "issue_types": [
        "Bug",
        "Defect"
      ],
      "labels": [
        "bug",
        "bugfix"
      ]
    },
    "feature": {
      "issue_types": [
        "Story",
        "Feature",
        "New Feature",
        "Epic"
      ],
      "labels": [
        "feature",
        "enhancement"
      ]
    },
    "chore": {
      "issue_types": [
        "Task",
        "Sub-task",
        "Maintenance"
      ],
      "labels": [
        "chore",
        "maintenance",
        "refactor"
      ]
    }
  },
  "repositories": [
    {
      "name": "my-buddy-service",
      "path": "~/Development/my-buddy-service",
      "provider": "github",
      "aliases": [
        "my-buddy",
        "buddy-service"
      ],
      "jira": {
        "projects": [
          "HER"
        ],
        "components": [
          "backend"
        ],
        "labels": [
          "repo:my-buddy-service"
        ]
      }
    },
    {
      "name": "sang-team-hermes",
      "path": "~/Development/sang-team-hermes",
      "provider": "bitbucket",
      "aliases": [
        "hermes"
      ],
      "jira": {
        "projects": [
          "HER"
        ],
        "components": [
          "automation"
        ],
        "labels": [
          "repo:sang-team-hermes"
        ]
      }
    }
  ]
}
