# Official Atlassian Jira/Rovo MCP is configured in ~/.hermes/config.yaml.
# Paste the official Atlassian MCP endpoint from your Atlassian/Rovo admin docs.
ATLASSIAN_MCP_URL=https://replace-with-official-atlassian-mcp-endpoint
ATLASSIAN_MCP_OAUTH_CLIENT_ID=
ATLASSIAN_MCP_OAUTH_CLIENT_SECRET=
HERMES_ATLASSIAN_MCP_SERVER=atlassian
HERMES_ATLASSIAN_MCP_TOOLS=mcp_atlassian_searchJiraIssues,mcp_atlassian_getJiraIssue,mcp_atlassian_createJiraIssue,mcp_atlassian_assignJiraIssue,mcp_atlassian_transitionJiraIssue
HERMES_MCP_TOOL_CATALOG=

# This plugin manages one Hermes project and one Hermes Kanban board.
HERMES_PROJECT_KEY=HER
HERMES_PROJECT_NAME=Hermes Delivery
HERMES_KANBAN_BOARD=Hermes Delivery Board
HERMES_KANBAN_STATE_PATH=~/.hermes/atlassian-hermes-connector/kanban.json

# Repository discovery and matching.
HERMES_DEVELOPMENT_ROOT=~/Development
HERMES_REPO_MAP=~/Development/atlassian-hermes-connector/config/repositories.private.json
HERMES_JIRA_REPO_FIELD=Repository

# Hermes profile and execution mode.
HERMES_PROFILE=default
HERMES_AUTOMATION_MODE=manual
HERMES_JIRA_ASSIGNEE=you@example.com

# Branch naming. Defaults derive prefixes from Jira issue type/labels/priority.
HERMES_BRANCH_DEFAULT_TYPE=chore
# HERMES_BRANCH_FORCE_PREFIX=feature/

# Pull request planning. PR creation requires provider MCP or an approved CLI fallback.
HERMES_PR_PROVIDER=auto
HERMES_PR_BASE_BRANCH=main
HERMES_REQUIRE_REVIEW_BEFORE_PR=true
HERMES_GITHUB_MCP_TOOL=mcp_github_create_pull_request
HERMES_BITBUCKET_MCP_TOOL=mcp_bitbucket_create_pull_request
