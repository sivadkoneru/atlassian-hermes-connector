JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-with-jira-api-token
JIRA_API_VERSION=3
JIRA_AUTH_MODE=basic
JIRA_PROJECT_KEY=HER
JIRA_DEFAULT_ISSUE_TYPE=Task
JIRA_BOARD_ID=replace-with-kanban-board-id-if-needed

HERMES_DEVELOPMENT_ROOT=~/Development
HERMES_REPO_MAP=./config/repositories.example.json
HERMES_JIRA_REPO_FIELD=Repository
HERMES_JIRA_PROFILE_ACCOUNT_ID=replace-with-jira-account-id
HERMES_PROFILE=default
HERMES_BRANCH_PREFIX=hermes/
HERMES_PR_PROVIDER=auto
HERMES_PR_BASE_BRANCH=main
HERMES_REQUIRE_REVIEW_BEFORE_PR=true
HERMES_DEBUG=0

GH_TOKEN=replace-with-github-token-if-gh-cli-needs-it

BITBUCKET_USERNAME=replace-with-bitbucket-username
BITBUCKET_APP_PASSWORD=replace-with-bitbucket-app-password
BITBUCKET_WORKSPACE=replace-with-workspace
BITBUCKET_REPO_SLUG=replace-with-repo-slug
BITBUCKET_API_BASE_URL=https://api.bitbucket.org/2.0
